# 本地工具目录
.zcode/

# 根目录临时运行、评测、审阅与参考材料（仅本地保留）
/.tmp-*

# 本地生成文档与历史归档（README 资产统一放 assets/readme/）；正式文档入库
/docs/*
!/docs/architecture.md
!/docs/api.md
!/docs/database-er.md
# 文档生成脚本（个人用，仅本地使用，不入库）
/_docs_gen/
# 学习文档（个人学习资料，仅本地使用，不入库）
/学习文档/
# 根目录 PDF（简历/面试包装文档，仅本地使用，不入库）
/*.pdf
/个人文档/
/简历/
/resumes/

# 本地运行数据（公开样例与评测基准可版本化；运行产物不入库）
data/chroma/
data/echoguide.db
data/memory.db
data/eval/results/
data/eval/chroma/
data/eval/memory.db
# error_analysis 下的 json 是分析脚本的运行产物（evaluation/error_analysis/*.py --out 默认路径）
data/eval/error_analysis/
logs/
backups/

